{
  "sources": [
    {
      "id": "flow-1",
      "text": "一号玩家给了二号玩家一百分。",
      "pieces": [
        "一号玩家给了二号玩家一百分"
      ]
    },
    {
      "id": "flow-2",
      "text": "二号玩家请求收取一百二十五分，请确认。",
      "pieces": [
        "二号玩家请求收取一百二十五分请确认"
      ]
    },
    {
      "id": "flow-3",
      "text": "二号玩家收了一号玩家的一百二十五分。",
      "pieces": [
        "二号玩家收了一号玩家的一百二十五分"
      ]
    },
    {
      "id": "flow-4",
      "text": "三号玩家给了二号玩家一分。",
      "pieces": [
        "三号玩家给了二号玩家一分"
      ]
    },
    {
      "id": "flow-5",
      "text": "本局开始，祝大家玩得开心。",
      "pieces": [
        "本局开始祝大家玩得开心"
      ]
    },
    {
      "id": "flow-6",
      "text": "现在请一号玩家行动。",
      "pieces": [
        "现在请一号玩家行动"
      ]
    },
    {
      "id": "flow-7",
      "text": "一号玩家闷注十分。",
      "pieces": [
        "一号玩家闷注十分"
      ]
    },
    {
      "id": "flow-8",
      "text": "二号玩家看牌。",
      "pieces": [
        "二号玩家看牌"
      ]
    },
    {
      "id": "flow-9",
      "text": "二号玩家跟注二十分。",
      "pieces": [
        "二号玩家跟注二十分"
      ]
    },
    {
      "id": "flow-10",
      "text": "三号玩家弃牌。",
      "pieces": [
        "三号玩家弃牌"
      ]
    },
    {
      "id": "flow-11",
      "text": "一号玩家看牌。",
      "pieces": [
        "一号玩家看牌"
      ]
    },
    {
      "id": "flow-12",
      "text": "一号玩家比牌四十分。",
      "pieces": [
        "一号玩家比牌四十分"
      ]
    },
    {
      "id": "flow-13",
      "text": "等待房主确认比牌赢家。",
      "pieces": [
        "等待房主确认比牌赢家"
      ]
    },
    {
      "id": "flow-14",
      "text": "二号玩家比牌出局。",
      "pieces": [
        "二号玩家比牌出局"
      ]
    },
    {
      "id": "flow-15",
      "text": "本局已结算一号玩家获得一百分。",
      "pieces": [
        "本局已结算一号玩家获得一百分"
      ]
    },
    {
      "id": "flow-16",
      "text": "底牌发牌完成。",
      "pieces": [
        "底牌发牌完成"
      ]
    },
    {
      "id": "flow-17",
      "text": "一号玩家加注一百分。",
      "pieces": [
        "一号玩家加注一百分"
      ]
    },
    {
      "id": "flow-18",
      "text": "二号玩家跟注九十五分。",
      "pieces": [
        "二号玩家跟注九十五分"
      ]
    },
    {
      "id": "flow-19",
      "text": "请助手烧一张牌，发三张翻牌。",
      "pieces": [
        "请助手烧一张牌发三张翻牌"
      ]
    },
    {
      "id": "flow-20",
      "text": "翻牌发牌完成。",
      "pieces": [
        "翻牌发牌完成"
      ]
    },
    {
      "id": "flow-21",
      "text": "一号玩家过牌。",
      "pieces": [
        "一号玩家过牌"
      ]
    },
    {
      "id": "flow-22",
      "text": "二号玩家下注二十分。",
      "pieces": [
        "二号玩家下注二十分"
      ]
    },
    {
      "id": "flow-23",
      "text": "一号玩家跟注二十分。",
      "pieces": [
        "一号玩家跟注二十分"
      ]
    },
    {
      "id": "flow-24",
      "text": "请助手烧一张牌，发一张转牌。",
