      ]
    },
    {
      "id": "flow-26",
      "text": "二号玩家过牌。",
      "pieces": [
        "二号玩家过牌"
      ]
    },
    {
      "id": "flow-27",
      "text": "请助手烧一张牌，发一张河牌。",
      "pieces": [
        "请助手烧一张牌发一张河牌"
      ]
    },
    {
      "id": "flow-28",
      "text": "河牌发牌完成。",
      "pieces": [
        "河牌发牌完成"
      ]
    },
    {
      "id": "flow-29",
      "text": "一号玩家下注一百分。",
      "pieces": [
